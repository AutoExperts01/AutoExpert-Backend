{
  "name": "AutoExpert-Backend",
  "version": "1.0.0",
  "description": "The AutoExpert Node Backend System",
  "main": "src/server.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "docker:build": "docker build -t autoexpert-backend .",
    "docker:run": "docker run --env-file .env -e NODE_ENV=production -p 3000:3000 autoexpert-backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.1",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pino": "^7.0.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pino": "^10.4.0"
  }
}