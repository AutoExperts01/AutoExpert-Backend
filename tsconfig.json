{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true /* Prevents OS-specific naming bugs */,
    "types": ["node"] /*automatically load global Node.js types*/,
    "noUnusedParameters": true
  },
  "include": ["src/**/*"]
}
